# The admin Laravel API remains on APP_URL=http://localhost:8001.
# The admin Expo dev server is intentionally separate from system mobile:
# system mobile = 8081, admin mobile = 8082.
# The admin app's Expo web URL is http://localhost:8082; Laravel admin routes
# remain under http://localhost:8001/admin.
# For a physical device, replace localhost with the computer's LAN IP.
EXPO_PUBLIC_ADMIN_API_URL=http://127.0.0.1:8001

# Set false when using a tunnel, Tailscale, staging, or production URL.
DETECT_LAN_IP=true
